data/*
!data/.gitkeep
# The GeoIP databases are committed: the PS requires a complete offline
# solution, and a clone that cannot resolve an address is not one. Git does
# not descend into an excluded directory, so the directory itself has to be
# un-excluded before its contents can be.
!data/geoip/
!data/geoip/*
target/
__pycache__/
*.pyc
.venv/
vendor/
wheelhouse/
images.tar

.DS_Store

# local reference clones, not part of the project
.reference/

# rust build artifacts
ingest/target/

# generated store
store/
